import Std.Map.{Map}
import Std.Set.{Set}

fn ascending(n: Int, end: Int, acc: Map[Int, Int]) -> Map[Int, Int] {
  if n == end { acc } else { ascending(n + 1, end, Map.insert(acc, n, n * 3)) }
}

fn descending(n: Int, acc: Map[Int, Int]) -> Map[Int, Int] {
  if n < 0 { acc } else { descending(n - 1, Map.insert(acc, n, n * 3)) }
}

fn remove_even(n: Int, end: Int, acc: Map[Int, Int]) -> Map[Int, Int] {
  if n >= end { acc } else { remove_even(n + 2, end, Map.remove(acc, n)) }
}

fn remove_all(n: Int, end: Int, acc: Map[Int, Int]) -> Map[Int, Int] {
  if n >= end { acc } else { remove_all(n + 1, end, Map.remove(acc, n)) }
}

fn verify(n: Int, end: Int, m: Map[Int, Int]) -> () {
  if n < end {
    assert Map.get(m, n) == Some(n * 3)
    verify(n + 1, end, m)
  }
}

@export(c, "collections")
pub fn collections() -> Int {
  empty: Map[Int, Int] = Map.empty()
  assert Map.is_empty(empty) && Map.size(empty) == 0
  assert Map.get(empty, 0) == None && !Map.contains(empty, 0)
  a = ascending(0, 120, empty)
  b = descending(119, Map.empty())
  assert Map.size(a) == 120 && a == b
  verify(0, 120, a)
  assert Map.keys(a) == List.range(0, 120)
  changed = Map.insert(a, 60, 999)
  assert Map.get(changed, 60) == Some(999) && Map.get(a, 60) == Some(180)
  assert Map.size(changed) == 120
  odds = remove_even(0, 120, a)
  assert Map.size(odds) == 60 && !Map.contains(odds, 60) && Map.contains(odds, 61)
  assert Map.size(a) == 120 && Map.remove(odds, -1) == odds
  assert Map.is_empty(remove_all(0, 120, odds))
  small = Map.from_list([(2, "old"), (1, "one"), (2, "new")])
  assert Map.to_list(small) == [(1, "one"), (2, "new")]
  assert Map.keys(small) == [1, 2] && Map.values(small) == ["one", "new"]
  other = Map.from_list([(2, "right"), (3, "three")])
  merged = Map.union(small, other)
  assert Map.to_list(merged) == [(1, "one"), (2, "new"), (3, "three")]
  assert Show.show(small) == "Map.from_list([(1, \"one\"), (2, \"new\")])"
  set = Set.from_list([3, 1, 2, 3, 1])
  assert Set.size(set) == 3 && Set.to_list(set) == [1, 2, 3]
  assert Set.contains(set, 2) && !Set.contains(set, 9)
  assert Set.to_list(Set.remove(Set.insert(set, 4), 2)) == [1, 3, 4]
  assert Set.to_list(Set.union(set, Set.from_list([2, 4]))) == [1, 2, 3, 4]
  assert set == Set.from_list([2, 3, 1])
  assert Show.show(set) == "Set.from_list([1, 2, 3])"
  assert Set.is_empty(Set.empty())
  42
}

import Std.Map.{Map}
import Std.Set.{Set}
import Std.Bytes.{Bytes}

@external(c, "trace")
fn trace(n: Int) -> Int

fn identity[A](value: A) -> A { value }
fn add(a: Int, b: Int) -> Int { a + b }
fn make_adder(bias: Int) -> fn(Int) -> Int { fn(n) { bias + n } }

@export(c, "stdlib_callbacks")
pub fn run() -> Int {
  assert Option.map(Some(20), fn(n) { n + 22 }) == Some(42)
  assert Option.map(None, fn(n: Int) { trace(99) + n }) == None
  assert Option.and_then(Some(41), fn(n) { Some(n + 1) }) == Some(42)
  assert Option.and_then(None, fn(n: Int) { Some(trace(99) + n) }) == None
  xs = List.map([1, 2, 3], fn(n) { trace(n) })
  assert List.map(xs, identity) == xs
  assert List.map(xs, Some) == [Some(1), Some(2), Some(3)]
  assert List.filter(xs, fn(n) { n % 2 == 1 }) == [1, 3]
  assert List.fold(xs, from: 0, f: add) == 6
  assert List.partition(xs, fn(n) { n % 2 == 0 }) == ([2], [1, 3])
  assert List.any(xs, fn(n) { trace(n + 10) >= 12 })
  assert !List.all(xs, fn(n) { trace(n + 20) < 23 })
  assert List.find(xs, fn(n) { trace(n + 30) == 32 }) == Some(2)
  assert List.find_index(xs, fn(n) { trace(n + 40) == 42 }) == Some(1)
  assert List.flat_map(xs, fn(n) { [n, -n] }) == [1, -1, 2, -2, 3, -3]
  assert List.filter_map(xs, fn(n) { if n % 2 == 1 { Some(n * 10) } else { None } }) == [10, 30]
  ordered = List.sort_by([(2, 0), (1, 1), (2, 2), (1, 3)], fn((a, _), (b, _)) { Ord.compare(a, b) })
  assert ordered == [(1, 1), (1, 3), (2, 0), (2, 2)]
  assert List.sort([3, 1, 2]) == [1, 2, 3]
  assert List.unzip(ordered) == ([1, 1, 2, 2], [1, 3, 0, 2])
  tree = Map.from_list([(3, 30), (1, 10), (2, 20)])
  assert Map.fold(tree, 0, fn(acc, key, value) { trace(key + 50)
    acc + value }) == 60
  changed = Map.update(tree, 2, fn(value) { Option.map(value, fn(n) { n + 1 }) })
  assert Map.get(changed, 2) == Some(21)
  assert Map.get(tree, 2) == Some(20)
  removed = Map.update(tree, 2, fn(_) { None })
  assert Map.get(removed, 2) == None
  inserted = Map.update(tree, 4, fn(_) { Some(40) })
  assert Map.get(inserted, 4) == Some(40)
  assert Map.to_list(Map.map_values(tree, fn(n) { n + 1 })) == [(1, 11), (2, 21), (3, 31)]
  assert Map.to_list(Map.filter(tree, fn(key, value) { key != 2 && value > 0 })) == [(1, 10), (3, 30)]
  set = Set.from_list([3, 1, 2, 3])
  assert Set.fold(set, 0, fn(acc, n) { trace(n + 60)
    acc + n }) == 6
  assert Set.to_list(Set.filter(set, fn(n) { n % 2 == 1 })) == [1, 3]
  assert String.to_ascii_lowercase("AéZ") == "aéz"
  assert String.to_ascii_uppercase("aéz") == "AéZ"
  assert String.is_empty("")
  assert Bytes.to_hex(Bytes.hex("0080ff")) == "0080ff"
  f: fn(Int) -> Int = make_adder(40)
  f(2)
}

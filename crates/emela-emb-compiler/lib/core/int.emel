# Independent P1 numeric declarations. Intrinsics are bound to declaration IDs.
@intrinsic
pub fn bit_and(a: Int, b: Int) -> Int
@intrinsic
pub fn bit_or(a: Int, b: Int) -> Int
@intrinsic
pub fn bit_xor(a: Int, b: Int) -> Int
@intrinsic
pub fn bit_not(n: Int) -> Int
@intrinsic
pub fn shift_left(n: Int, by: Int) -> Int
@intrinsic
pub fn shift_right(n: Int, by: Int) -> Int
@intrinsic
pub fn shift_right_unsigned(n: Int, by: Int) -> Int
pub fn min(a: Int, b: Int) -> Int { if a < b { a } else { b } }
pub fn max(a: Int, b: Int) -> Int { if a > b { a } else { b } }
pub fn abs(n: Int) -> Int { if n < 0 { -n } else { n } }

# Prelude (spec 15.1). Visible from every module without an import. Only pure items go here.
#
# Int, Int64, Float, String, Never and List are built into the compiler, so they are not declared
# here. So are the traits Eq, Ord and Show (spec 10.6), and their impls for the primitive
# types and tuples. List and Option have theirs in list.emel and option.emel.

# Bool and its False/True constructors are compiler-owned primitives in this repository.
# Their Eq/Ord/Show meaning is preserved without declaring a second nominal Bool.

## Eq, Ord and Show are in option.emel (spec 10.6).
pub enum Option[A] {
  Some(A)
  None
}

pub enum Ordering {
  Less
  Equal
  Greater
}
  derive Eq, Ord, Show

## Raises a defect whose description is `message`.
@intrinsic
pub fn panic(message: String) -> Never

## A placeholder for unwritten code. Raises a `not yet implemented` defect.
@intrinsic
pub fn todo() -> Never

## Prints the debug display of `value` to stderr on one line and returns the value. For
## debugging. Any value: a type that satisfies Show is shown like `inspect`, any other as it is
## constructed in source (`Plain(name: <a>, f: <fn>)`), its parts that satisfy Show through Show.
@intrinsic
pub fn dbg[A](value: A) -> A

## The debug display of a value: its Show, with a String quoted even at the top level
## (`inspect("a")` is `"a"` with the quotes).
@intrinsic
pub fn inspect[A: Show](value: A) -> String

## The input of a `parse` was not in the expected form (spec 15.3). `input` is the whole input.
pub error ParseError(input: String) derive Show
